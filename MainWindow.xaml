<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трио — аудиовывод" Width="838" Height="780" MinWidth="686" MinHeight="520"
        Background="#101518" Foreground="#F3F7F6" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Language="ru-RU">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F3F7F6"/>
        <SolidColorBrush x:Key="Muted" Color="#A4B4B5"/>
        <SolidColorBrush x:Key="Accent" Color="#81F0C7"/>
        <SolidColorBrush x:Key="Line" Color="#314047"/>
        <SolidColorBrush x:Key="Surface" Color="#182126"/>
        <SolidColorBrush x:Key="Field" Color="#10191D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#265C4F"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F7F6"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="#2A373D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Edge" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Edge" Property="Opacity" Value="0.43"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#10261F"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#2A4643"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="285"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="FieldEdge" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Margin="0,0,13,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FieldEdge" Property="BorderBrush" Value="#6E8A8D"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FieldEdge" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock x:Name="SelectedText" Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" Margin="12,0,30,0"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                                   VerticalOffset="3" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{StaticResource Surface}" BorderBrush="#4B6467" BorderThickness="1"
                                        CornerRadius="6" Padding="3" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectedText" Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRail" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRail}" Background="{StaticResource Accent}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRail}" Background="#3C4E54"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource Accent}" Stroke="#C4FFE8" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OutputTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="184"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Data="M 1,10 V 7 A 6,6 0 0 1 13,7 V 10 M 1,8 H 3 V 13 H 1 Z M 11,8 H 13 V 13 H 11 Z"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.25" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OutputTitle" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OutputState" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="OutputSelect" Grid.Row="1" Margin="0,0,22,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="Громкость" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="51"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Volume" Margin="0,0,8,0"/>
                        <TextBlock x:Name="Percent" Grid.Column="1" FontWeight="SemiBold"
                                   FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="32,24,32,21">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid Margin="0,0,0,21">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1D423B" Width="55" Height="55" CornerRadius="13" VerticalAlignment="Top" Margin="0,3,14,0">
                        <Path Data="M 0,12 H 5 L 9,4 L 14,20 L 19,1 L 24,15 L 27,12 H 32"
                              Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Трио" FontSize="36" FontWeight="SemiBold" LineHeight="42"/>
                        <TextBlock Text="Один звук для пяти устройств" Style="{StaticResource MutedText}" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B292D" CornerRadius="15" Padding="11,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RunDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunState" Text="Остановлено" Style="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16,13,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="184"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Канал Windows и Zoom" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
                    <TextBlock Grid.Column="1" Text="Входной сигнал" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    <TextBlock x:Name="ChannelName" Grid.Row="1" Margin="0,0,22,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="SignalMeter" Grid.Column="1" Grid.Row="1" Height="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ChannelHint" Grid.Row="2" Style="{StaticResource MutedText}" Margin="0,0,18,0"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="OpenSound" Content="Звук Windows" HorizontalAlignment="Left" Padding="11,6" FontSize="12"/>
                        <TextBlock x:Name="InstallCable" Margin="0,4,0,4" FontSize="13" Visibility="Collapsed">
                            <Hyperlink x:Name="CableLink" Foreground="{StaticResource Accent}" NavigateUri="https://vb-audio.com/Cable/">Скачать VB-CABLE</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,17,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Устройства вывода" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button x:Name="Refresh" Grid.Column="1" Content="Обновить список" Padding="11,6" FontSize="12"/>
            </Grid>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Outputs"/>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#26343A" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,13,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Help" VerticalAlignment="Center" Margin="0,0,20,0"
                           TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                <Button x:Name="Toggle" Content="Запустить вывод" Grid.Column="1" MinWidth="158" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
